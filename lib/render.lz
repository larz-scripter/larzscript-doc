# render - turn a set of packages into a single markdown reference.
#
#   import "lib/render.lz" as render
#   render.reference(packages)   # -> markdown
#
# One file, not a site. The thing this ecosystem lacks is somewhere to look
# a function up; a static-site generator would be a bigger project that
# solved a smaller part of that.

fn _anchor(name) { return "#" + name }

fn reference(pkgs) {
  let out = "# Larzscript package reference\n\n"
  out = out + "Generated by [larzdoc](https://github.com/larz-scripter/larzscript-doc) from package sources.\n\n"

  let total_fns = 0
  for p in pkgs { total_fns = total_fns + len(p["exports"]) }
  out = out + str(len(pkgs)) + " packages, " + str(total_fns) + " public functions.\n\n"

  out = out + "## Index\n\n"
  out = out + "| package | functions | summary |\n|---|---|---|\n"
  for p in pkgs {
    out = out + "| [" + p["name"] + "](" + _anchor(p["name"]) + ") | "
    out = out + str(len(p["exports"])) + " | " + p["summary"] + " |\n"
  }
  out = out + "\n"

  for p in pkgs {
    out = out + "## " + p["name"] + "\n\n"
    if p["summary"] != "" { out = out + p["summary"] + "\n\n" }
    out = out + "```\nimport \"" + p["name"] + "\" as " + p["alias"] + "\n```\n\n"

    if len(p["exports"]) > 0 {
      out = out + "| function | documented |\n|---|---|\n"
      for e in p["exports"] {
        let mark = p["documented"].has(e["name"]) ? "yes" : "—"
        out = out + "| `" + e["name"] + e["sig"] + "` | " + mark + " |\n"
      }
      out = out + "\n"
    }

    if len(p["header"]) > 0 {
      out = out + "<details><summary>header</summary>\n\n```\n"
      for line in p["header"] { out = out + line + "\n" }
      out = out + "```\n\n</details>\n\n"
    }
  }
  return out
}
