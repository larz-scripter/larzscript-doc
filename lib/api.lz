# api - read a package's public surface and its documented surface, and
# compare them.
#
#   import "lib/api.lz" as api
#   let p = api.read(path)
#   p["name"], p["summary"], p["header"], p["exports"], p["documented"]
#   api.drift(p)             # -> {undocumented: [...], phantom: [...]}
#
# The pieces read() is built from, exported because they are individually
# useful and because a tool that reports undocumented exports should not
# have any:
#
#   api.header_lines(src)         # the leading # block, markers stripped
#   api.exports(src)              # public fn definitions, from the tokens
#   api.header_alias(header, own) # the alias the header gives this package
#   api.documented(header, alias) # fn names the header shows being called
#
# EXPORTS come from the token stream, not a grep: a `fn` inside a comment
# or a string is not a definition, and package headers are full of usage
# examples that mention functions in prose.
#
# DOCUMENTED calls come from the header comment block - the run of `#`
# lines at the top of the file. Across the published packages the
# convention is consistent:
#
#   # heap - a readable, array-backed binary heap...
#   #
#   #   import "heap" as heap
#   #   heap.push(h, 5)
#
# so a documented call is `<something>.<name>(` inside that block.
#
# A leading underscore marks a private helper by convention throughout the
# package set, and those are excluded from both sides.

import "lex.lz" as lex

fn _stem(path) {
  let parts = path.split("/")
  let last = parts[len(parts) - 1]
  if last.ends_with(".lz") { return last.replace(".lz", "") }
  return last
}

# The run of comment lines at the top of the file, '#' stripped.
fn header_lines(src) {
  let out = []
  for line in src.split("\n") {
    let t = line.strip()
    if t == "" {
      if len(out) == 0 { continue }
      out.push("")
      continue
    }
    if not t.starts_with("#") { break }
    let body = t[1:len(t)]
    if body.starts_with(" ") { body = body[1:len(body)] }
    out.push(body)
  }
  # drop trailing blanks
  while len(out) > 0 and out[len(out) - 1] == "" { out.pop() }
  return out
}

# "heap - a readable, array-backed binary heap. Min-heap by default"
# The leading paragraph, not the first line. Headers wrap at about 72
# columns, so taking line 0 alone cut summaries mid-sentence ("a readable,
# array-backed binary heap. Min-heap by default").
fn _summary(header) {
  if len(header) == 0 { return "" }
  let first = header[0]
  let i = 1
  while i < len(header) and header[i] != "" {
    first = first + " " + header[i].strip()
    i = i + 1
  }
  let bits = first.split(" - ")
  if len(bits) > 1 {
    let rest = ""
    let i = 1
    while i < len(bits) {
      if i > 1 { rest = rest + " - " }
      rest = rest + bits[i]
      i = i + 1
    }
    return rest.strip()
  }
  return first.strip()
}

# Public `fn name(params)` definitions, in source order.
fn exports(src) {
  let toks = []
  for t in lex.tokens(src) {
    if t["kind"] == "ws" or t["kind"] == "nl" { continue }
    toks.push(t)
  }
  let out = []
  let i = 0
  while i + 1 < len(toks) {
    if toks[i]["kind"] == "ident" and toks[i]["text"] == "fn" and toks[i + 1]["kind"] == "ident" {
      let name = toks[i + 1]["text"]
      if not name.starts_with("_") {
        # collect the parameter list verbatim
        let sig = ""
        let j = i + 2
        if j < len(toks) and toks[j]["kind"] == "op" and toks[j]["text"] == "(" {
          let depth = 0
          while j < len(toks) {
            let tx = toks[j]["text"]
            if toks[j]["kind"] == "op" and tx == "(" { depth = depth + 1 }
            if toks[j]["kind"] == "op" and tx == ")" {
              depth = depth - 1
              sig = sig + tx
              if depth == 0 { break }
              j = j + 1
              continue
            }
            if toks[j]["kind"] == "op" and tx == "," { sig = sig + ", "  j = j + 1  continue }
            sig = sig + tx
            j = j + 1
          }
        }
        out.push({"name": name, "sig": sig})
      }
    }
    i = i + 1
  }
  return out
}

# The alias this package is given in its own header: `import "genetic" as ga`
# means documented calls look like `ga.evolve(...)`. Falls back to the
# package name when the header uses `import "x"` with no alias.
fn header_alias(header, own) {
  for line in header {
    let t = line.strip()
    if not t.starts_with("import \"") { continue }
    let parts = t.split("\"")
    if len(parts) < 2 { continue }
    if parts[1] != own { continue }
    let tail = parts[2].strip()
    if tail.starts_with("as ") { return tail[3:len(tail)].strip() }
    return own
  }
  return own
}

# Function names mentioned as `<alias>.name(` in the header block.
#
# Scoped to the package's OWN alias deliberately. A header may import other
# packages to show context - genetic.lz imports random as rng and writes
# rng.seed(1) - and counting those made seed and randint look like
# functions genetic was documenting but had not implemented. Three of the
# four "documented but missing" findings on the published corpus were that
# mistake.
fn documented(header, alias) {
  let out = {}
  let prefix = alias + "."
  for line in header {
    let i = 0
    while i < len(line) {
      if line[i] == "." and i >= len(alias) and line[i - len(alias):i] == alias {
        let j = i + 1
        let name = ""
        while j < len(line) {
          let c = line[j]
          if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" or (c >= "0" and c <= "9") {
            name = name + c
            j = j + 1
          } else {
            break
          }
        }
        if name != "" and j < len(line) and line[j] == "(" {
          if not name.starts_with("_") { out[name] = true }
        }
        i = j
        continue
      }
      i = i + 1
    }
  }
  return out
}

fn read(path) {
  let src = read_file(path)
  let header = header_lines(src)
  let own = _stem(path)
  let alias = header_alias(header, own)
  return {
    "path": path,
    "name": own,
    "alias": alias,
    "header": header,
    "summary": _summary(header),
    "exports": exports(src),
    "documented": documented(header, alias)
  }
}

# Where the documentation and the code disagree.
fn drift(p) {
  let undoc = []
  let have = {}
  for e in p["exports"] {
    have[e["name"]] = true
    if not p["documented"].has(e["name"]) { undoc.push(e["name"]) }
  }
  let phantom = []
  for d in p["documented"].keys() {
    if not have.has(d) { phantom.push(d) }
  }
  phantom.sort()
  return {"undocumented": undoc, "phantom": phantom}
}
